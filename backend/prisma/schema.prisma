// Prisma schema for FinFlow Database (PostgreSQL / Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(uuid())
  memberId              String?       @unique // Society Member ID
  email                 String        @unique
  passwordHash          String
  name                  String
  dob                   DateTime?     // Date of Birth
  lastLogin             DateTime?     // Last login timestamp
  role                  String        @default("COMMITTEE_MEMBER") // Role: ADMIN, PRESIDENT, TREASURER, COMMITTEE_MEMBER
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  managedEvents         Event[]       @relation("EventManager")
  submittedTransactions Transaction[] @relation("SubmittedTransactions")
  approvedTransactions  Transaction[] @relation("ApprovedTransactions")
  auditLogs             AuditLog[]
}

model Event {
  id               String           @id @default(uuid())
  name             String           // Event Name
  venue            String?          // Event Venue
  description      String?          @db.Text
  status           String           @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, CLOSED
  totalBudget      Decimal          @db.Decimal(18, 2) @default(0.00)
  startDate        DateTime
  endDate          DateTime
  managedById      String           // Managed By User ID
  managedBy        User             @relation("EventManager", fields: [managedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  budgetItems      BudgetItem[]
  transactions     Transaction[]
  financialReports FinancialReport[]
}

model BudgetCategory {
  id          String       @id @default(uuid())
  name        String       @unique // e.g. Food, Transport, Venue, Equipment, Printing
  description String?
  createdAt   DateTime     @default(now())

  // Relations
  budgetItems BudgetItem[]
}

model BudgetItem {
  id              String         @id @default(uuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categoryId      String
  category        BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemName        String         // Budget Item name/description
  quantity        Int            @default(1)
  unitPrice       Decimal        @db.Decimal(18, 2)
  allocatedAmount Decimal        @db.Decimal(18, 2) // quantity * unitPrice
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  transactions    Transaction[]
}

model Transaction {
  id                    String            @id @default(uuid())
  title                 String
  type                  String            // INCOME or EXPENSE
  amount                Decimal           @db.Decimal(18, 2)
  receiptUrl            String?           // Receipt image / PDF URL
  status                String            @default("PENDING") // PENDING, APPROVED, REJECTED
  isOverBudget          Boolean           @default(false)   // Budget comparison flag
  overrideJustification String?           @db.Text // Justification if over budget
  rejectionReason       String?           @db.Text
  
  // Linked Event & Budget Item
  eventId               String
  event                 Event             @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budgetItemId          String?
  budgetItem            BudgetItem?       @relation(fields: [budgetItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Submitter & Approver
  submittedById         String
  submittedBy           User              @relation("SubmittedTransactions", fields: [submittedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById          String?
  approvedBy            User?             @relation("ApprovedTransactions", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model FinancialReport {
  id           String   @id @default(uuid())
  year         Int      // Financial Year (e.g. 2026)
  eventId      String?  // Linked Event (or null for annual summary)
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  totalIncome  Decimal  @db.Decimal(18, 2)
  totalExpense Decimal  @db.Decimal(18, 2)
  netProfit    Decimal  @db.Decimal(18, 2) // totalIncome - totalExpense
  generatedAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt  DateTime @default(now())
}
