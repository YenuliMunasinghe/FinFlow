# FinFlow Backend Environment Variables Example

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL / Supabase Prisma)
DATABASE_URL="postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres"

# JWT Authentication Secret Key
JWT_SECRET=super_secret_finflow_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d

# Cloudinary (Receipt & Document Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
