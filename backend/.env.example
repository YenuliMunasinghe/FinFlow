# FinFlow Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Microsoft SQL Server Database Connection (Prisma)
DATABASE_URL="sqlserver://localhost:1433;database=FinFlowDB;user=sa;password=YourStrongPassword#123;encrypt=true;trustServerCertificate=true;"

# JWT Authentication
JWT_SECRET=super_secret_finflow_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d

# Cloudinary (Receipt & Document Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
